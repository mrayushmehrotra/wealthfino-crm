#!/bin/sh
# Post-commit hook — write a commit-specific project context snapshot

echo "🧠 Writing commit context snapshot..."
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
VENV_PYTHON="$ROOT_DIR/.venv/bin/python3"
if [ ! -x "$VENV_PYTHON" ]; then
    echo "⚠ Virtual env not found at $VENV_PYTHON"
    echo "  Run: python3 -m venv .venv && .venv/bin/pip install chromadb"
    exit 1
fi
"$VENV_PYTHON" "$ROOT_DIR/scripts/build-context.py"
exit $?
